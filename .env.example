# ==========================================
# REChain Frontend Environment Variables
# ==========================================
# Copy this file to .env and update values for your environment.

# Backend API base URL (without trailing /api)
# Local development:
VITE_API_BASE_URL=http://localhost:4000
# Production example:
# VITE_API_BASE_URL=https://real-estate-website-backend-zfu7.onrender.com

# Feature flag for AI Property Hub navigation/page
VITE_ENABLE_AI_HUB=true

# Serve local fixtures instead of calling the backend (development only).
# The backend is not part of this repository, so without this the property
# detail page renders its error state. See src/services/mockProperty.ts.
#
# WARNING: this is inlined at build time. Leave unset or set to false for any
# production build, or the deployed site will serve fixture data.
VITE_USE_MOCK_DATA=true